root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.ps1]
# PowerShell 5 读无 BOM 的 UTF-8 会按 ANSI 解码，中文注释直接把脚本解析崩
charset = utf-8-bom
indent_size = 4

[*.java]
indent_size = 4
